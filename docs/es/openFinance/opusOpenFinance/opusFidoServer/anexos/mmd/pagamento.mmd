sequenceDiagram
    autonumber
    
    participant U as Usuario
    participant A as App ITP
    participant B as Backend ITP
    participant D as Backend Institución Titular
    participant AS as Authorization Server Institución Titular
    participant F as Opus FIDO Server
    
    Note over B,AS: Precondición:<br/>DCR/DCM en el AS-FAPI con FIDO Origins<br/>Consentimiento de vínculo de dispositivo
    
    rect rgb(245, 245, 255)
        Note over U,F: Iniciación del Pago
        
        U->>A: Selecciona la cuenta usada para el pago<br/>sin redireccionamiento (debtorAccount)
        A-->>B: 
        
        B->>D: POST /token<br/>(grant_type=client_credentials)
        D-->>B: access_token
        
        B->>D: POST /consents<br/>{ ...creditor, payment, debtorAccount, ... }<br/>Authorization: Bearer access_token
        D<<-->>AS: 
        D-->>B: 201 Created<br/>{ ... status: AWAITING_AUTHORISATION, consentId }
    end
    
    rect rgb(255, 245, 245)
        Note over U,F: Preparación de la Firma FIDO2
        
        B->>D: POST /enrollments/{enrollmentId}/fido-sign-options<br/>Authorization: Bearer access_token<br/>{ ... consentId }
        D<<-->>AS:
        
        D->>F: POST /assertion/options<br/>Body: AssertionOptionsRequest
        F-->>D: 200 OK<br/>AssertionOptionsResponse<br/>{ challenge, ... }
        
        D-->>B: 201<br/>{ fidoChallenge, ... }
    end
    
    rect rgb(245, 255, 245)
        Note over U,F: Autenticación FIDO2
        
        B->>A: Solicita firma FIDO2<br/>{ fidoChallenge, ... }
        A->>U: Solicita gesto de autenticación al usuario
        U->>A: Realiza gesto<br/>(ej.: biometría, PIN)
        
        A->>B: Envía fidoAssertion<br/>{ signature, authenticatorData,<br/>clientDataJSON, ... }<br/>+ Extracción de señales de riesgo del dispositivo
    end
    
    rect rgb(255, 255, 245)
        Note over U,F: Autorización del Consentimiento
        
        B->>D: POST /token<br/>(grant_type=refresh_token,<br/>refresh_token=enrollment_refresh_token)
        AS<<-->>D: 
        D->>B: 201<br/>{ payment_access_token, payment_refresh_token }
        
        B->>D: POST /consents/{consentId}/authorise<br/>Authorization: Bearer payment_access_token<br/>{ riskSignals, fidoAssertion, ... }
        
        D<<-->>AS:
        
        D->>F: POST /assertion/result<br/>Body: AssertionResultRequest
        F-->>D: 200 OK<br/>ResponseStatus
        
        activate D
        D->>D: El consentimiento de pagos<br/>transita a AUTHORISED
        deactivate D
        
        D->>B: 204 No Content
    end
    
    rect rgb(240, 255, 240)
        Note over U,F: Ejecución del Pago
        
        B->>D: POST /pix/payments<br/>{ ... consentId }<br/>Authorization: Bearer payment_access_token
        D<<-->>AS:
        AS-->>D: OK
        D-->>B: 201 Created<br/>{ ... status: RCVD, paymentId }
        
        activate D
        D->>D: Ejecuta el pago
        deactivate D
        
        B->>D: GET /pix/payments/{paymentId}<br/>Authorization: Bearer access_token
        D<<-->>AS: 
        D-->>B: 200 OK<br/>{ ... status: ACSC }
        
        B-->>U: Éxito
    end
