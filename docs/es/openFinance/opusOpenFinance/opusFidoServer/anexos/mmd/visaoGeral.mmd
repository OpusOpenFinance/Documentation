graph TB
    subgraph "Fase 1: Preparación"
        DCR[DCR/DCM]
    end
    
    subgraph "Fase 2: Vinculación"
        ENV[Enrollment]
        RISK[Risk Signals]
        AUTH[Autorización]
        FIDO_REG[Registro FIDO2]
    end
    
    subgraph "Fase 3: Pago"
        CONSENT[Consentimiento]
        FIDO_SIGN[Firma FIDO2]
        PAY[Pago PIX]
    end
    
    DCR --> ENV
    ENV --> RISK
    RISK --> AUTH
    AUTH --> FIDO_REG
    FIDO_REG --> CONSENT
    CONSENT --> FIDO_SIGN
    FIDO_SIGN --> PAY
