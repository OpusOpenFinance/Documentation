graph TB
    subgraph "Phase 1: Preparation"
        DCR[DCR/DCM]
    end
    
    subgraph "Phase 2: Binding"
        ENV[Enrollment]
        RISK[Risk Signals]
        AUTH[Authorization]
        FIDO_REG[FIDO2 Registration]
    end
    
    subgraph "Phase 3: Payment"
        CONSENT[Consent]
        FIDO_SIGN[FIDO2 Signature]
        PAY[PIX Payment]
    end
    
    DCR --> ENV
    ENV --> RISK
    RISK --> AUTH
    AUTH --> FIDO_REG
    FIDO_REG --> CONSENT
    CONSENT --> FIDO_SIGN
    FIDO_SIGN --> PAY
